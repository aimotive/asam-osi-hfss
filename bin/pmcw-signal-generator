#!/bin/sh
# PMCW CDM-MIMO signal generator: SensorView + AntennaModel -> RadarCpiData.
# Usage: pmcw-signal-generator --sensor-view F --antenna F [--config F.json] [--raw] [--noise-free] [--encoding E] [--analysis F.npz] [--description F.json] [-o F]
# This launcher runs the implementation in lib/radar-modules; replace it to use another implementation.
exec "$(dirname "$0")/lib/radar-modules" pmcw-signal-generator "$@"
